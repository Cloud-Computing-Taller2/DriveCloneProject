# Copy to .env before running docker compose up.
# Rootless Docker cannot bind host port 80; set HTTP_PORT=8080 there.
HTTP_PORT=80
PORT=3000
WORKER_PORT=3001
FRONT_URL=http://localhost

# API and worker inside Docker use the db service; on the host use localhost:5432.
DATABASE_URL=postgres://drive:drive@db:5432/driveclone

# LocalStack defaults work with test/test. Replace AWS keys with:
#   terraform -chdir=infra output -raw iam_access_key_id
#   terraform -chdir=infra output -raw iam_secret_access_key
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=driveclone-storage
SQS_QUEUE_URL=http://localstack:4566/000000000000/driveclone-jobs
SQS_DLQ_URL=http://localstack:4566/000000000000/driveclone-jobs-dlq

# Uploads: same 50 MB limit as client_max_body_size in NGINX.
UPLOAD_TMP_DIR=/data/uploads
MAX_UPLOAD_BYTES=52428800
WORKER_CONCURRENCY=4
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_MS=10000
ALLOW_DEV_AUTH=false

# Cloudflare Tunnel (see docs/demo.md); never commit the real token.
TUNNEL_TOKEN=

# Frontend (frontend/.env.example): VITE_API_URL=/api
